# Base URL for the Laravel API.
#
# Leave this EMPTY to use same-origin requests through the Vite dev proxy.
# vite.config.js forwards /api/* -> http://127.0.0.1:8000, which keeps the
# Laravel session cookie first-party so SESSION AUTH WORKS in development.
#
# Only set an absolute URL (e.g. http://127.0.0.1:8000) if the API is on a
# different origin AND that origin is allowed in backend/config/cors.php
# with supports_credentials = true.
VITE_API_URL=